---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

import PageMediaHero from '../components/PageMediaHero.astro';
import EmbedLauncher from '../components/EmbedLauncher.astro';
import MoreServices from '../components/MoreServices.astro';
import PageCta from '../components/PageCta.astro';
import Footer from '../components/Footer.astro';

import content from '../data/unreal-engine.json';
---

<Layout title={content.meta.title} description={content.meta.description} page="ink">
  <Header logo="white" />
  <main>
    <!-- 1. VIDEO HERO + INTRO -->
    <PageMediaHero
      title={content.hero.title}
      sources={content.hero.sources}
      poster={content.hero.poster}
      intro={content.hero.intro}
      sticky={false}
    />

    <!-- 2. INTERACTIVE TOUR (opens in a dialog) -->
    <EmbedLauncher
      name={content.tour.name}
      label={content.tour.label}
      image={content.tour.image}
      embed={content.tour.embed}
    />

    <!-- 3. MORE SERVICES -->
    <MoreServices
      title={content.moreServices.title}
      cta={content.moreServices.cta}
      items={content.moreServices.items}
    />

    <!-- 4. CALL TO ACTION -->
    <PageCta title={content.cta.title} link={content.cta.link} />
  </main>
  <Footer />
</Layout>
