---
// src/components/ResourceRatings.astro
interface Props {
  title: string;
  body: string;
  items: { label: string; stars: number }[];
}

import Words from './Words.astro';
import Lines from './Lines.astro';

const { title, body, items } = Astro.props;
const STAR = 'M234.29,114.85l-45,38.83L203,211.75a16.4,16.4,0,0,1-24.5,17.82L128,198.49,77.47,229.57A16.4,16.4,0,0,1,53,211.75l13.76-58.07-45-38.83A16.46,16.46,0,0,1,31.08,86l59-4.76,22.76-55.08a16.36,16.36,0,0,1,30.27,0l22.75,55.08,59,4.76a16.46,16.46,0,0,1,9.37,28.86Z';
const STAR_OUTLINE = 'M237.28,97.87A14.18,14.18,0,0,0,224.76,88l-60.25-4.87-23.22-56.2a14.37,14.37,0,0,0-26.58,0L91.49,83.11,31.24,88a14.18,14.18,0,0,0-12.52,9.89A14.43,14.43,0,0,0,23,113.32L69,152.93l-14,59.25a14.4,14.4,0,0,0,5.59,15,14.1,14.1,0,0,0,15.91.6L128,196.12l51.58,31.71a14.1,14.1,0,0,0,15.91-.6,14.4,14.4,0,0,0,5.59-15l-14-59.25L233,113.32A14.43,14.43,0,0,0,237.28,97.87Zm-12.14,6.37-48.69,42a6,6,0,0,0-1.92,5.92l14.88,62.79a2.35,2.35,0,0,1-.95,2.57,2.24,2.24,0,0,1-2.6.1L131.14,184a6,6,0,0,0-6.28,0L70.14,217.61a2.24,2.24,0,0,1-2.6-.1,2.35,2.35,0,0,1-1-2.57l14.88-62.79a6,6,0,0,0-1.92-5.92l-48.69-42a2.37,2.37,0,0,1-.73-2.65,2.28,2.28,0,0,1,2.07-1.65l63.92-5.16a6,6,0,0,0,5.06-3.69l24.63-59.6a2.35,2.35,0,0,1,4.38,0l24.63,59.6a6,6,0,0,0,5.06,3.69l63.92,5.16a2.28,2.28,0,0,1,2.07,1.65A2.37,2.37,0,0,1,225.14,104.24Z';
---

<!-- Rounded-top panel listing the kinds of input we can work from, each with
     a five-star rating. Sticks to the top while the next panels slide over. -->
<section class="ratings">
  <div class="ratings__head">
    <h2 data-reveal="word" data-reveal-on="view"><Words text={title} /></h2>
    <p data-reveal="line" data-reveal-on="view" style="--reveal-start: 0.4s"><Lines text={body} /></p>
  </div>

  <ul class="ratings__list">
    {items.map((item) => (
      <li class="ratings__item">
        <p>{item.label}</p>
        <div class="ratings__stars" role="img" aria-label={`${item.stars} out of 5 stars`}>
          {[1, 2, 3, 4, 5].map((n) => (
            <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d={n <= item.stars ? STAR : STAR_OUTLINE} />
            </svg>
          ))}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .ratings {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 50px 20px;
    border-radius: 30px 30px 0 0;
    background: var(--color-page);
  }
  @media (min-width: 810px) {
    .ratings { padding-top: 0; padding-bottom: 30px; border-radius: 50px 50px 0 0; }
  }
  @media (min-width: 1200px) {
    .ratings { padding-inline: 30px; }
  }

  .ratings__head {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 20px;
  }
  @media (min-width: 810px) {
    .ratings__head { padding-bottom: 10px; }
  }
  .ratings__head h2 {
    margin: 0;
    font-size: 46px;
    line-height: 1;
  }
  .ratings__head p {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .ratings__head h2 { font-size: 56px; }
    .ratings__head p { width: 50%; font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .ratings__head h2 { font-size: 64px; }
    .ratings__head p { font-size: 18px; line-height: 21.6px; }
  }

  .ratings__list {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 810px) {
    .ratings__list { margin-top: 32px; }
  }
  @media (min-width: 1200px) {
    .ratings__list { margin-top: 62px; }
  }

  .ratings__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 0;
    border-top: 1px solid currentColor;
  }
  .ratings__item p {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .ratings__item { flex-direction: row; }
    .ratings__item p { flex: 1; font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .ratings__item p { font-size: 18px; line-height: 21.6px; }
  }

  .ratings__stars {
    display: flex;
    gap: 10px;
    height: 26px;
  }
  .ratings__stars svg { flex: none; width: 23px; height: 23px; }
  @media (min-width: 810px) {
    .ratings__stars { flex: 1; height: 28px; }
    .ratings__stars svg { width: 28px; height: 28px; }
  }
</style>
