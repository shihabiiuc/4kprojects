---
// src/components/HomeReviews.astro
interface Props {
  widgetId: string;
}

const { widgetId } = Astro.props;
---

<!-- Client reviews, rendered by the Wally embed script into the div below. -->
<section class="reviews">
  <div class="reviews__inner">
    <div class="reviews__widget" data-wally-widget={widgetId}></div>
  </div>
</section>
<script is:inline defer id="wally-embed-script" src="https://embed.getwally.net/embed.js"></script>

<style>
  .reviews {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding: 50px 0 100px;
    background: var(--color-beige);
  }
  @media (min-width: 810px) {
    .reviews { padding-block: 60px; }
  }
  @media (min-width: 1200px) {
    .reviews { padding: 50px 0 100px; }
  }

  .reviews__inner {
    position: relative;
    z-index: 10;
    flex: 1;
    width: 1px;
    font-family: sans-serif;
    font-size: 12px;
    line-height: normal;
  }
  @media (min-width: 1200px) {
    .reviews__inner { flex: none; width: 1000px; }
  }

  .reviews__widget { width: 100%; height: 100%; }
  .reviews__widget :global(iframe) { display: inline; vertical-align: baseline; }
</style>
