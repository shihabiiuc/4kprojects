---
// src/components/WorkSlider.astro
interface Props {
  slides: { image: string; alt: string }[];
}

const { slides } = Astro.props;
// A copy of the last slide goes first and a copy of the first goes last,
// so the track can loop seamlessly in both directions.
const track = [slides[slides.length - 1], ...slides, slides[0]];
---

<!-- Full-screen image carousel: autoplays every 3s while on screen,
     and can be dragged or flicked. -->
<section class="work-slider-section">
  <div class="work-slider" aria-roledescription="carousel" aria-label="Our work" data-slider>
    <ul class="work-slider__track" data-slider-track>
      {track.map((slide, i) => {
        const isClone = i === 0 || i === track.length - 1;
        return (
          <li
            class="work-slider__slide"
            aria-hidden={isClone ? 'true' : undefined}
            aria-roledescription={isClone ? undefined : 'slide'}
            aria-label={isClone ? undefined : `${i} of ${slides.length}`}
          >
            <img
              src={slide.image}
              alt={isClone ? '' : slide.alt}
              loading={i === 1 ? 'eager' : 'lazy'}
              fetchpriority={i === 1 ? 'high' : undefined}
              decoding="async"
              draggable="false"
            />
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  const AUTOPLAY_MS = 3000;
  const TRANSITION = 'translate 0.6s var(--ease-slide)';

  function initSlider(slider: HTMLElement) {
    const track = slider.querySelector<HTMLElement>('[data-slider-track]');
    if (!track) return;
    const count = track.children.length - 2; // real slides, without the clones
    if (count < 2) return;

    // Load every slide once the page has finished loading.
    const loadAll = () => track.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
    if (document.readyState === 'complete') loadAll();
    else window.addEventListener('load', loadAll, { once: true });

    let index = 1;
    let timer: number | undefined;
    let visible = false;
    let dragging = false;

    const place = (offset = 0, animate = true) => {
      track.style.transition = animate ? TRANSITION : 'none';
      track.style.translate = `calc(${-index * 100}% + ${offset}px) 0`;
    };
    const go = (step: number) => {
      index = Math.min(Math.max(index + step, 0), count + 1);
      place();
    };

    // After landing on a clone, jump to the real slide it copies.
    track.addEventListener('transitionend', (e) => {
      if (e.target !== track || (index !== 0 && index !== count + 1)) return;
      index = index === 0 ? count : 1;
      place(0, false);
    });

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const stop = () => window.clearTimeout(timer);
    const schedule = () => {
      stop();
      if (!visible || document.hidden || dragging || reducedMotion.matches) return;
      timer = window.setTimeout(() => {
        go(1);
        schedule();
      }, AUTOPLAY_MS);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      schedule();
    }).observe(slider);
    document.addEventListener('visibilitychange', schedule);

    // Drag / flick
    let startX = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;

    slider.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      loadAll();
      if (index === 0 || index === count + 1) index = index === 0 ? count : 1;
      dragging = true;
      stop();
      startX = lastX = e.clientX;
      lastT = e.timeStamp;
      velocity = 0;
      slider.setPointerCapture(e.pointerId);
      place(0, false);
    });
    slider.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dt = e.timeStamp - lastT;
      if (dt > 0) velocity = ((e.clientX - lastX) / dt) * 1000;
      lastX = e.clientX;
      lastT = e.timeStamp;
      place(e.clientX - startX, false);
    });
    const release = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      const dx = e.clientX - startX;
      const width = slider.offsetWidth;
      const steps = Math.max(1, Math.round(Math.abs(dx) / width));
      if (velocity < -200 || (velocity <= 200 && dx < -width / 2)) go(steps);
      else if (velocity > 200 || dx > width / 2) go(-steps);
      else place();
      schedule();
    };
    slider.addEventListener('pointerup', release);
    slider.addEventListener('pointercancel', release);
  }

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(initSlider);
</script>

<style>
  .work-slider-section { position: relative; }

  .work-slider {
    position: relative;
    height: 100vh;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .work-slider:active { cursor: grabbing; }

  .work-slider__track {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    translate: -100% 0;
  }

  .work-slider__slide {
    flex: none;
    width: 100%;
    height: 100%;
  }
  .work-slider__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
