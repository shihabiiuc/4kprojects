---
// src/components/TeamSection.astro
interface Member {
  name: string;
  role: string;
  info: string;
  image: string;
}
interface Props {
  title: string;
  subtitle: string;
  members: Member[];
}

const { title, subtitle, members } = Astro.props;
---

<section class="team">
  <div class="team__heading">
    <h2>{title}</h2>
    <p>{subtitle}</p>
  </div>

  <!-- Hovering (or keyboard-focusing) a card fades the photo to the bio. -->
  <div class="team__grid">
    {members.map((m) => (
      <article class="team-card" tabindex="0">
        <div class="team-card__media">
          <img
            src={m.image}
            alt={m.name}
            sizes="(min-width: 1200px) 33vw, (min-width: 810px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
          />
          <div class="team-card__bio">
            <p>{m.info}</p>
          </div>
        </div>
        <h3 class="team-card__name">{m.name}</h3>
        <p class="team-card__role">{m.role}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .team {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 40px var(--gutter);
    background: var(--color-sand);
  }
  @media (min-width: 810px) {
    .team { padding-top: 50px; }
  }
  @media (min-width: 1200px) {
    .team { padding-top: 100px; }
  }

  .team__heading {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .team__heading h2 {
    margin: 0;
    font-size: 46px;
    line-height: 1;
  }
  .team__heading p {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .team__heading h2 { font-size: 56px; }
    .team__heading p { font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .team__heading h2 { font-size: 64px; }
    .team__heading p { width: 50%; font-size: 18px; line-height: 21.6px; }
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(286px, 1fr));
    gap: 45px;
  }
  @media (min-width: 810px) {
    .team__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 20px; }
  }
  @media (min-width: 1200px) {
    .team__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .team-card {
    cursor: pointer;
    outline-offset: 4px;
    font-family: "DM Sans", sans-serif;
  }

  .team-card__media {
    position: relative;
    height: 535px;
    overflow: hidden;
    border-radius: 20px;
  }
  .team-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid #000;
    border-radius: inherit;
    pointer-events: none;
  }
  .team-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  .team-card__bio {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-sand);
    opacity: 0;
    transition: opacity 400ms var(--ease-card);
  }
  .team-card__bio p {
    margin: 0;
    padding: 25px 20px 0;
    font-size: 18px;
    line-height: 21.6px;
    opacity: 0;
    transition: opacity 400ms var(--ease-bio);
  }
  .team-card:focus-visible .team-card__bio,
  .team-card:focus-visible .team-card__bio p { opacity: 1; }
  .team-card:focus-visible .team-card__bio p { transition-delay: 300ms; }
  @media (hover: hover) {
    .team-card:hover .team-card__bio,
    .team-card:hover .team-card__bio p { opacity: 1; }
    .team-card:hover .team-card__bio p { transition-delay: 300ms; }
  }

  .team-card__name {
    margin: 20px 0 0;
    padding-left: 20px;
    font-family: "DM Sans", sans-serif;
    font-size: 28px;
    line-height: 33.6px;
    font-weight: 500;
  }
  .team-card__role {
    margin: 10px 0 0;
    padding-left: 20px;
    font-size: 18px;
    line-height: 21.6px;
    white-space: pre;
  }
</style>
