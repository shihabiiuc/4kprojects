---
// src/components/ContactHero.astro
import Words from './Words.astro';
import Lines from './Lines.astro';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<!-- Page title and intro. Unlike the other page heroes it doesn't stick. -->
<section class="contact-hero">
  <h1 class="contact-hero__title" data-reveal="word" data-reveal-on="mount"><Words text={title} /></h1>
  <p class="contact-hero__lead" data-reveal="line" data-reveal-on="mount" style="--reveal-start: 0.4s">
    <Lines text={lead} />
  </p>
</section>

<style>
  .contact-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    overflow: hidden;
    padding: 200px var(--gutter) 40px;
  }
  @media (min-width: 810px) {
    .contact-hero { gap: 20px; padding-bottom: 50px; }
  }

  .contact-hero__title {
    width: 100%;
    margin: 0;
    font-size: 46px;
    line-height: 1;
  }
  @media (min-width: 810px) {
    .contact-hero__title { width: 95%; font-size: 80px; }
  }
  @media (min-width: 1200px) {
    .contact-hero__title { width: 100%; font-size: 150px; }
  }

  .contact-hero__lead {
    width: 47%;
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .contact-hero__lead { font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .contact-hero__lead { font-size: 18px; line-height: 21.6px; }
  }
</style>
