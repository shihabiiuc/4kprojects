---
// src/components/WhatsAppButton.astro
---

<!-- Fixed "Live Chat" button. On desktop hover it expands into a black pill
     with a label. It fades out with the header while scrolling down, and on
     the home page stays hidden until the hero has been scrolled past. -->
<a
  class="whatsapp"
  href="https://wa.me/447418627274"
  target="_blank"
  rel="noopener"
  aria-label="Live Chat on WhatsApp (opens in a new tab)"
>
  <span class="whatsapp__label">Live Chat</span>
  <svg viewBox="0 0 48 48" aria-hidden="true">
    <path class="whatsapp__disc" d="M 0.545 24 C 0.545 11.046 11.046 0.545 24 0.545 C 36.954 0.545 47.455 11.046 47.455 24 C 47.455 36.954 36.954 47.455 24 47.455 C 11.046 47.455 0.545 36.954 0.545 24 Z" stroke-width="1.09" stroke-miterlimit="10" />
    <defs>
      <linearGradient id="whatsapp-gradient" x1="0.9769" x2="0.0231" y1="0" y2="1">
        <stop offset="0" stop-color="#eadfd1" />
        <stop offset="1" stop-color="#dbdcd0" />
      </linearGradient>
    </defs>
    <path transform="translate(10.182 10.182)" fill="url(#whatsapp-gradient)" d="whatsapp-gradient" />
  </svg>
</a>

<style>
  .whatsapp {
    position: fixed;
    right: 40px;
    bottom: 40px;
    z-index: 9;
    display: flex;
    align-items: center;
    transition: opacity 200ms var(--ease-nav);
  }
  :global(html[data-nav-hidden]) .whatsapp:not(:focus-visible) { opacity: 0; }
  :global(html[data-nav-whatsapp="hide"]) .whatsapp { opacity: 0; pointer-events: none; }

  .whatsapp svg {
    display: block;
    flex: none;
    width: 48px;
    height: 48px;
  }
  .whatsapp__disc { fill: #000; stroke: var(--color-beige); }

  .whatsapp__label {
    display: none;
    max-width: 0;
    overflow: hidden;
    color: #fff;
    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    line-height: 21.6px;
    white-space: nowrap;
    transition: max-width 200ms var(--ease-nav), margin-right 200ms var(--ease-nav);
  }

  @media (min-width: 1200px) {
    .whatsapp {
      transition-property: padding, background-color, border-radius, opacity;
    }
    .whatsapp__label { display: block; }
  }
  @media (min-width: 1200px) and (hover: hover) {
    .whatsapp:hover {
      padding: 5px 8px;
      border-radius: 10px;
      background: #000;
    }
    .whatsapp:hover .whatsapp__label { max-width: 78px; margin-right: 10px; }
  }
</style>
