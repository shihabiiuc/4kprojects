---
// src/components/MoreServices.astro
interface Service {
  title: string;
  body: string;
  href?: string;
  image: string;
  alt: string;
  w: number;
  h: number;
}
interface Props {
  title: string;
  cta: { label: string; href: string };
  items: Service[];
}

import Words from './Words.astro';
import UnderlineLink from './UnderlineLink.astro';

const { title, cta, items } = Astro.props;
---

<!-- Two image cards linking to other services. On desktop, hovering a linked
     card grows its image inside the rounded frame. -->
<section class="more-services" data-nav-lines="white">
  <div class="more-services__head">
    <h2 class="more-services__title" data-reveal="word" data-reveal-on="view"><Words text={title} /></h2>
    <UnderlineLink href={cta.href} label={cta.label} large />
  </div>

  <div class="more-services__grid">
    {items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <Tag href={item.href} class:list={['service-tile', item.href && 'service-tile--link']}>
          <div class="service-tile__frame">
            <div class="service-tile__zoom">
              <img src={item.image} alt={item.alt} width={item.w} height={item.h} loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="service-tile__text">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </Tag>
      );
    })}
  </div>
</section>

<style>
  .more-services {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 40px var(--gutter);
    background: #000;
    color: #fff;
  }
  @media (min-width: 810px) {
    .more-services { gap: 80px; padding-block: 100px; }
  }

  .more-services__head {
    display: flex;
    flex-direction: column;
    gap: 35px;
  }
  @media (min-width: 810px) {
    .more-services__head { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 0; }
  }

  .more-services__title {
    margin: 0;
    font-size: 46px;
    line-height: 1;
  }
  @media (min-width: 810px) {
    .more-services__title { width: 505px; font-size: 56px; }
  }
  @media (min-width: 1200px) {
    .more-services__title { font-size: 64px; }
  }

  .more-services__grid {
    display: grid;
    gap: 10px;
  }
  @media (min-width: 810px) {
    .more-services__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .service-tile {
    display: flex;
    flex-direction: column;
    gap: 15px;
    min-width: 0;
    padding-bottom: 30px;
  }

  .service-tile__frame {
    position: relative;
    aspect-ratio: 1.7;
    width: 100%;
    overflow: hidden;
    border-radius: 15px;
  }
  .service-tile__zoom {
    position: absolute;
    inset: 0;
    transition: inset 600ms var(--ease-reveal);
  }
  .service-tile__zoom img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 810px) {
    .service-tile--link:hover .service-tile__zoom { inset: -11px -20px -11px -19px; }
  }

  .service-tile__text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-right: 10px;
  }
  .service-tile__text h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1;
  }
  .service-tile__text p {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .service-tile__text h3 { font-size: 28px; }
    .service-tile__text p { font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .service-tile__text p { font-size: 18px; line-height: 21.6px; }
  }
  @media (min-width: 1280px) {
    .service-tile__text h3 { font-size: 36px; }
  }
</style>
