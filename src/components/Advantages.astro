---
// src/components/Advantages.astro
interface Item {
  /** Title lines (joined with a line break). */
  title: string[];
  body: string;
}
interface Props {
  title: string;
  body: string;
  link?: { label: string; href: string; after: string };
  items: Item[];
  /** Black with page-colour text, or the page colour with black text. */
  theme?: 'ink' | 'page';
  /** On desktop, stick at this top offset so the next section slides over. */
  stickyLg?: number;
}

import Words from './Words.astro';
import Lines from './Lines.astro';
import UnderlineLink from './UnderlineLink.astro';

const { title, body, link, items, theme = 'ink', stickyLg } = Astro.props;
---

<!-- Black section: an intro column on the left (pinned on desktop) and a list
     of advantages on the right. On tablet/desktop the list slides in from the
     right once the section top reaches the bottom of the screen; on phones the
     items stack over each other as you scroll. -->
<section
  id="advantages"
  class:list={['advantages', `advantages--${theme}`, stickyLg !== undefined && 'advantages--sticky']}
  style={stickyLg !== undefined && `--sticky-lg: ${stickyLg}px`}
>
  <div class="advantages__intro">
    <h2 data-reveal="word" data-reveal-on="view"><Words text={title} /></h2>
    <p class="advantages__body" data-reveal="line" data-reveal-on="view" style="--reveal-start: 0.4s"><Lines text={body} /></p>
    {link && (
      <p class="advantages__link">
        <UnderlineLink href={link.href} label={link.label} newTab inline /> {link.after}
      </p>
    )}
  </div>

  <div class="advantages__list">
    {items.map((item) => (
      <div class="advantage" data-scroll-trigger data-trigger="advantages" data-threshold="1" data-once>
        <h3 data-reveal="word" data-reveal-on="view">
          {item.title.map((line, i) => <>{i > 0 && <br />}<Words text={line} /></>)}
        </h3>
        <p data-reveal="line" data-reveal-on="view" style="--reveal-start: 0.4s"><Lines text={item.body} /></p>
      </div>
    ))}
  </div>
</section>

<style>
  .advantages {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .advantages--ink { background: #000; color: var(--color-page); }
  .advantages--page { background: var(--color-page); color: #000; }
  @media (min-width: 810px) {
    .advantages { gap: 80px; padding: 80px 30px; }
  }
  @media (min-width: 1200px) {
    .advantages {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0;
      padding-top: 0;
      padding-bottom: 150px;
    }
    .advantages--sticky { position: sticky; top: var(--sticky-lg); }
  }

  /* ── Intro column ── */
  .advantages__intro {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 20px;
  }
  @media (max-width: 809px) {
    .advantages__intro { position: sticky; top: 50px; z-index: 1; overflow: hidden; }
  }
  @media (min-width: 810px) {
    .advantages__intro { gap: 20px; padding: 0 20px 0 0; }
  }
  @media (min-width: 1200px) {
    .advantages__intro { position: sticky; top: 40px; z-index: 1; flex: 1; }
  }

  .advantages__intro h2 {
    margin: 0;
    font-size: 46px;
    line-height: 1;
  }
  @media (min-width: 810px) {
    .advantages__intro h2 { font-size: 56px; }
  }
  @media (min-width: 1200px) {
    .advantages__intro h2 { font-size: 64px; }
  }

  .advantages__body,
  .advantage p {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .advantages__body,
    .advantage p { font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .advantages__body { max-width: 90%; }
    .advantages__body,
    .advantage p { font-size: 18px; line-height: 21.6px; }
  }

  .advantages__link {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 16px;
    line-height: 17.6px;
  }

  /* ── List ── */
  .advantages__list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    background: inherit;
  }
  @media (min-width: 810px) {
    .advantages__list { overflow: hidden; background: none; }
  }
  @media (min-width: 1200px) {
    .advantages__list { flex: 1; }
  }

  .advantage {
    position: sticky;
    top: 330px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-height: 302px;
    padding: 40px 20px;
    border-top: 1px solid currentColor;
    background: inherit;
    transition: opacity 800ms var(--ease-reveal), translate 800ms var(--ease-reveal);
  }
  .advantage:last-child { border-top-color: transparent; }
  @media (min-width: 810px) {
    .advantage {
      position: relative;
      top: auto;
      flex-direction: row;
      justify-content: space-between;
      gap: 0;
      min-height: 0;
      padding: 0 0 40px;
      border-top: 0;
      border-bottom: 1px solid currentColor;
      background: transparent;
    }
    .advantage:first-child { padding-top: 5px; }
    .advantage:last-child { border-bottom: 0; }
    :global(.js) .advantage:not([data-active]) { opacity: 0; translate: 150px 0; }
    .advantage p { width: 49%; }
  }

  .advantage h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1;
  }
  @media (min-width: 810px) {
    .advantage h3 { white-space: nowrap; }
  }
</style>
