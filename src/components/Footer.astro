---
// src/components/Footer.astro
// Text colour follows the page colour (--footer, set from <body data-page>).
import UnderlineLink from './UnderlineLink.astro';
---

<footer class="site-footer" data-nav-lines="beige">
  <!-- TOP ROW -->
  <div class="footer-top">
    <a href="/" class="footer-logo">
      <span role="img" aria-label="4K Projects" class="footer-mask footer-mask--logo"></span>
    </a>

    <div class="footer-headline">
      <p>Architectural visualisation outsourcing</p>
      <p>As easy as it should be.</p>
      <UnderlineLink href="/visualisation" label="See our work" large />
    </div>

    <p class="footer-prompt">Get started with us by clicking <a href="/contact">here</a></p>
  </div>

  <!-- MIDDLE ROW -->
  <div class="footer-mid">
    <span role="img" aria-label="BIID Industry Partner" class="footer-mask footer-mask--biid"></span>

    <div class="footer-col footer-col--office">
      <h2>Head office</h2>
      <p>160 kemp house<br />City road, London<br />EC1V 2NX</p>
    </div>

    <div class="footer-col">
      <h2>Hiring</h2>
      <p>
        We are always on the lookout for exciting new talent. If you are interested in working with us, either as a 3D artist or a project manager. <br /><br />Please drop us a message at: <a href="mailto:hiring@4kprojects.com" target="_blank" rel="noopener">hiring@4kprojects.com</a>
      </p>
    </div>

    <div class="footer-col footer-col--contact">
      <h2>Contact</h2>
      <p>
        Be it a quote request, some feedback or you'd just like to say hello, we'd love to hear from you. <br /><br />Reach us at: <br />
        <a href="mailto:info@4kprojects.com" target="_blank" rel="noopener">info@4kprojects.com</a> <br />
        <a href="tel:+442039362228" target="_blank" rel="noopener">+44 20 3936 2228</a>
      </p>
    </div>
  </div>

  <!-- BOTTOM: WORDMARK, sized to fill the full width -->
  <span class="footer-wordmark" aria-hidden="true">
    <span>4K Projects</span>
  </span>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    padding: 50px var(--gutter);
    overflow: hidden;
    background: #000;
    color: var(--footer, var(--color-sand));
  }
  @media (min-width: 810px) {
    .site-footer { padding-bottom: 30px; }
  }

  /* Logos are PNG masks filled with the current text colour. */
  .footer-mask {
    display: block;
    flex: none;
    background-color: currentColor;
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
  }
  .footer-mask--logo {
    width: 100%;
    height: 100%;
    mask-image: url("/images/logos/4k-logo-light.png");
  }
  .footer-mask--biid {
    width: 170px;
    height: 72px;
    mask-image: url("/images/logos/biid-industry-partner.png");
  }

  /* ── Top row ── */
  .footer-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  @media (min-width: 1200px) {
    .footer-top { flex-direction: row; }
  }

  .footer-logo {
    display: block;
    flex: none;
    width: 84px;
    height: 72px;
  }
  @media (min-width: 810px) {
    .footer-logo { width: 95px; height: 82px; }
  }
  @media (min-width: 1200px) {
    .footer-logo { width: 147px; height: 127px; }
  }

  .footer-headline {
    width: 100%;
    height: 149px;
  }
  @media (min-width: 810px) {
    .footer-headline { height: 94px; }
  }
  @media (min-width: 1200px) {
    .footer-headline { width: auto; height: auto; flex: 1; }
  }
  .footer-headline p {
    margin: 0;
    font-family: "Source Serif 4 Regular", serif;
    font-size: 28px;
    line-height: 33.6px;
  }

  .footer-prompt {
    margin: 0;
    padding-bottom: 5px;
    font-family: "Source Serif 4 Regular", serif;
    font-size: 24px;
    line-height: 1;
  }
  .footer-prompt a { text-decoration: underline; }
  @media (min-width: 1200px) {
    .footer-prompt { flex: none; margin-right: 20px; }
  }

  /* ── Middle row ── */
  .footer-mid {
    display: flex;
    flex-direction: column;
    gap: 70px;
    margin-top: 80px;
  }
  @media (min-width: 810px) {
    .footer-mid { flex-direction: row; gap: 40px; }
  }
  @media (max-width: 809px) {
    .footer-mask--biid { order: 1; margin-top: -20px; }
  }

  .footer-col h2 {
    width: fit-content;
    margin: 0;
    font-family: "Source Serif 4 Regular", serif;
    font-size: 18px;
    line-height: 21.6px;
  }
  .footer-col p {
    margin: 8px 0 0;
    color: rgba(255, 255, 255, 0.5);
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .footer-col { flex: 1; min-width: 0; }
    .footer-col--office { flex: none; }
    .footer-col--contact p { font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .footer-col p { font-size: 16px; line-height: 19.2px; }
  }

  /* ── Wordmark ── */
  .footer-wordmark {
    display: block;
    width: 100%;
    margin-top: 40px;
    container-type: inline-size;
  }
  @media (min-width: 810px) {
    .footer-wordmark { margin-top: 90px; }
  }
  .footer-wordmark span {
    display: block;
    font-family: "Source Serif 4 Regular", serif;
    /* "4K Projects" is ~5.3em wide, so this fills the container exactly. */
    font-size: 18.854cqw;
    line-height: 1.2;
    white-space: nowrap;
  }
</style>
