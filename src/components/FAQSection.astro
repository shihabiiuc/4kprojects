---
// src/components/FAQSection.astro
import Words from './Words.astro';

interface Props {
  title: string[];
  items: { q: string; a: string }[];
}

const { title, items } = Astro.props;
---

<section class="faq">
  <div class="faq__inner">
    <div class="faq__heading">
      <h2 data-reveal="word" data-reveal-on="view">
        {title.map((line, i) => <>{i > 0 && <br />}<Words text={line} /></>)}
      </h2>
    </div>

    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item">
          <summary>
            <span>{item.q}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    padding: 50px var(--gutter);
    background: var(--color-sand);
    font-family: "DM Sans", sans-serif;
  }
  @media (min-width: 810px) {
    .faq { padding: 96px 64px; }
  }
  @media (min-width: 1200px) {
    .faq { padding: 80px 30px; }
  }

  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  @media (min-width: 1200px) {
    .faq__inner { flex-direction: row; align-items: flex-start; gap: 128px; }
  }

  .faq__heading { padding-top: 7px; }
  @media (min-width: 1200px) {
    .faq__heading { position: sticky; top: 80px; flex: 1; }
  }
  .faq__heading h2 {
    margin: 0;
    font-size: 46px;
    line-height: 1;
  }
  @media (min-width: 810px) {
    .faq__heading h2 { font-size: 56px; }
  }
  @media (min-width: 1200px) {
    .faq__heading h2 { font-size: 64px; }
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  @media (min-width: 1200px) {
    .faq__list { flex: 1; }
  }

  /* Answers open and close smoothly where ::details-content is supported. */
  .faq__item {
    padding-right: 20px;
    interpolate-size: allow-keywords;
  }
  .faq__item + .faq__item {
    padding-top: 10px;
    border-top: 1px solid #000;
  }
  .faq__item::details-content {
    height: 0;
    overflow: clip;
    transition: height 500ms var(--ease-faq), content-visibility 500ms var(--ease-faq) allow-discrete;
  }
  .faq__item[open]::details-content { height: auto; }

  summary {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary span {
    flex: 1;
    font-size: 18px;
    line-height: 21.6px;
    font-weight: 500;
  }
  @media (min-width: 810px) {
    summary span { font-size: 20px; line-height: 24px; }
  }
  @media (min-width: 1200px) {
    summary span { font-size: 24px; line-height: 28.8px; }
  }
  summary svg {
    flex: none;
    width: 32px;
    height: 32px;
    transition: rotate 500ms var(--ease-faq);
  }
  .faq__item[open] summary svg { rotate: 90deg; }

  .faq__item p {
    margin: 0;
    padding: 0 20px 40px 0;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 1200px) {
    .faq__item p { font-size: 16px; line-height: 19.2px; }
  }
</style>
