---
// src/components/AboutHero.astro
import Words from './Words.astro';
import Lines from './Lines.astro';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<!-- Sticky intro — the work slider scrolls up over it. -->
<section class="about-hero">
  <h1 class="about-hero__title" data-reveal="word" data-reveal-on="mount"><Words text={title} /></h1>
  <p class="about-hero__lead" data-reveal="line" data-reveal-on="mount" style="--reveal-start: 0.4s">
    <Lines text={lead} />
  </p>
</section>

<style>
  .about-hero {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    overflow: hidden;
    padding: 200px var(--gutter) 40px;
    pointer-events: none;
  }
  .about-hero > * { pointer-events: auto; }
  @media (min-width: 810px) {
    .about-hero { gap: 20px; padding-bottom: 50px; }
  }

  .about-hero__title {
    width: 100%;
    margin: 0;
    font-size: 88px;
    line-height: 1;
  }
  @media (min-width: 810px) {
    .about-hero__title { width: 95%; font-size: 120px; }
  }
  @media (min-width: 1200px) {
    .about-hero__title { font-size: 150px; }
  }

  .about-hero__lead {
    width: 100%;
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 16.8px;
  }
  @media (min-width: 810px) {
    .about-hero__lead { width: 95%; font-size: 16px; line-height: 19.2px; }
  }
  @media (min-width: 1200px) {
    .about-hero__lead { width: 47.5%; font-size: 18px; line-height: 21.6px; }
  }
</style>
